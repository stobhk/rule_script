#!arguments=TIMEOUT:120,CRONEXP: 22 8 * * *,CRONEXP2: 34 9 * * *


[Script]
小米抽奖 Cookie = type=http-request,pattern=^https:\/\/shop-api\.retail\.mi\.com\/mtop\/navi\/venue\/batch,requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/milottery/milottery.js,img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png
小米抽奖签到尝试1次 = type=cron,cronexp={{{CRONEXP}}},timeout={{{TIMEOUT}}},script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/milottery/milottery.js,img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png
小米抽奖签到尝试2次 = type=cron,cronexp={{{CRONEXP2}}},timeout={{{TIMEOUT}}},script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/milottery/milottery.js,img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png

[MITM]
hostname = %APPEND% shop-api.retail.mi.com
